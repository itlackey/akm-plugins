{
  "name": "akm",
  "displayName": "AKM",
  "description": "Search, show, and curate AKM concepts, record feedback, and turn corrections, preferences, memories, and recurring workflows into reviewable AKM proposals.",
  "version": "0.9.28-alpha.10.202610082053",
  "author": {
    "name": "itlackey",
    "url": "https://github.com/itlackey"
  },
  "homepage": "https://github.com/itlackey/akm-plugins#readme",
  "repository": "https://github.com/itlackey/akm-plugins",
  "license": "MPL-2.0",
  "keywords": [
    "akm",
    "bundle",
    "skills",
    "commands",
    "agents",
    "scripts",
    "registry",
    "plugin",
    "compound-engineering",
    "self-evolving"
  ],
  "skills": [
    "./skills/akm"
  ],
  "userConfig": {
    "bundle_dir": {
      "type": "directory",
      "title": "AKM bundle directory",
      "description": "Absolute path to the AKM bundle root. Leave empty to let the hooks discover it by running `akm info`. Setting it removes that subprocess from every file-tool hook, which is the single biggest hook-latency win available. Equivalent to the AKM_BUNDLE_DIR environment variable."
    },
    "auto_feedback": {
      "type": "boolean",
      "title": "Record feedback automatically",
      "description": "Submit positive `akm feedback` for concepts a successful tool call used, and credit concepts when you say something worked. A failed akm command is never recorded as feedback. Turn off to record feedback only via /akm-feedback. Equivalent to AKM_AUTO_FEEDBACK.",
      "default": true
    },
    "auto_learning": {
      "type": "boolean",
      "title": "Propose durable learnings automatically",
      "description": "Capture explicit memories, corrections, guardrails, and preferences from prompts and submit high-confidence AKM proposals for review. Repeated task intents across distinct sessions can also propose reusable skills. Equivalent to AKM_AUTO_LEARNING.",
      "default": true
    },
    "curate_limit": {
      "type": "number",
      "title": "Curated results per prompt",
      "description": "How many ranked concepts the curation hooks retrieve for a prompt or session. Higher values surface more but cost more time per turn. Equivalent to AKM_CURATE_LIMIT.",
      "default": 5,
      "min": 1,
      "max": 25
    },
    "index_on_session_end": {
      "type": "boolean",
      "title": "Refresh the AKM index when a session ends",
      "description": "Run `akm index` at SessionEnd so the local bundle stays current. Turn off on CI runners or low-power machines; the periodic `akm improve` pass remains the backstop. Equivalent to AKM_INDEX_ON_SESSION_END.",
      "default": true
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "session-start"
            ],
            "timeout": 120,
            "statusMessage": "Checking the AKM CLI and loading bundle hints..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "curate-prompt"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "user-prompt-expansion"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool",
              "success"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "auto-feedback",
              "success"
            ],
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "success"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "success"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "success"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "success"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "success"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool",
              "failure"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "failure"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "failure"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "failure"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "failure"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "failure"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-batch"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "subagent-start"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "task-created"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
