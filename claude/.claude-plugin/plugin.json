    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "session-end"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "extract-session"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
