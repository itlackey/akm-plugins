{
  "name": "akm",
  "displayName": "AKM",
  "description": "Search, show, and curate AKM concepts, record feedback, and turn corrections, preferences, memories, and recurring workflows into reviewable AKM proposals.",
  "version": "0.10.261125",
  "author": {
    "name": "itlackey",
    "url": "https://github.com/itlackey"
  },
  "homepage": "https://github.com/itlackey/akm-plugins#readme",
  "repository": "https://github.com/itlackey/akm-plugins",
  "license": "MPL-2.0",
  "keywords": [
    "akm",
    "bundle",
    "skills",
    "commands",
    "agents",
    "scripts",
    "registry",
    "plugin",
    "compound-engineering",
    "self-evolving"
  ],
  "skills": [
    "./skills/akm"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "session-start"
            ],
            "timeout": 120,
            "statusMessage": "Checking the AKM CLI and loading AKM context..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "curate-prompt"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptExpansion": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "user-prompt-expansion"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool",
              "success"
            ],
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "auto-feedback",
              "success"
            ],
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "success"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "success"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "success"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "success"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "success"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool",
              "failure"
            ],
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "failure"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "failure"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "failure"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Glob",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "failure"
            ],
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-nonbash",
              "failure"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolBatch": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-tool-batch"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "subagent-start"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "TaskCreated": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "task-created"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "TaskCompleted": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "task-completed"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "post-compact"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "session-end"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "bun",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/akm-hook.ts",
              "extract-session"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
