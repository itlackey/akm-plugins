{
  "name": "akm-plugins-evals",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Evaluation framework for the akm Claude Code and OpenCode plugins. Measures curation quality, hook latency, surface stability, context budget, feedback classification (tier-2), and end-to-end LLM-judged scenario outcomes (tier-3).",
  "scripts": {
    "tier2": "bun tier2/runner.ts",
    "tier2:curation": "bun tier2/runner.ts --metric curation",
    "tier2:latency": "bun tier2/runner.ts --metric latency",
    "tier2:surface": "bun tier2/runner.ts --metric surface",
    "tier2:context-budget": "bun tier2/runner.ts --metric context_budget",
    "tier2:feedback": "bun tier2/runner.ts --metric feedback",
    "tier3": "bun tier3/runner.ts",
    "tier3:ab": "bun tier3/ab.ts",
    "diff": "bun lib/cli-diff.ts",
    "baseline:update": "bun tier2/runner.ts --out tier2/baseline --no-fail"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.92.0",
    "yaml": "^2.6.0"
  }
}
