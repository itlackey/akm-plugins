{
  "name": "akm-opencode",
  "version": "0.9.14202609050009",
  "type": "module",
  "description": "OpenCode plugin for AKM 0.9 with in-process search, show, and curate tools plus feedback and remember.",
  "keywords": [
    "opencode",
    "opencode-ai",
    "opencode-plugin",
    "opencode-extensions",
    "akm",
    "ai-agent",
    "developer-tools",
    "plugin"
  ],
  "homepage": "https://github.com/itlackey/akm-plugins#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itlackey/akm-plugins.git",
    "directory": "opencode"
  },
  "bugs": {
    "url": "https://github.com/itlackey/akm-plugins/issues"
  },
  "license": "MPL-2.0",
  "files": [
    "dist/",
    "README.md"
  ],
  "main": "./dist/index.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "bun build ./index.ts --target=bun --outfile=dist/index.js --external @opencode-ai/plugin --external akm-cli",
    "prepack": "bun run build",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.14",
    "akm-cli": "^0.9.8"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "typescript": "^5.8.3"
  }
}
